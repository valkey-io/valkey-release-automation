# Maintainer: Valkey Build System <build@valkey.io>
#
# Built by valkey-io/valkey-release-automation. Generated by
# scripts/generate-from-templates.sh --type apk from
# packaging/templates/apk/APKBUILD.template. Layout, configuration and
# subpackage split follow packaging/templates/rpm/valkey.spec.template;
# systemd units are replaced by OpenRC scripts (packaging/common/apk).
pkgname=valkey
pkgver=@@PKGVER@@
pkgrel=0
# Upstream version and tarball directory (pkgver uses Alpine's _rcN syntax).
_srcver=@@SRCVER@@
# valkey-doc release for this line (MAJOR.MINOR.0). build-apk.sh sets
# _with_docs=0 when that tag does not exist (e.g. before a line's first doc
# release), which drops the -doc subpackage.
_docver=@@DOC_VERSION@@
_with_docs=1
_modules_abi=1
pkgdesc="Persistent key-value database"
url="https://valkey.io"
arch="x86_64 aarch64"
license="BSD-3-Clause AND BSD-2-Clause AND MIT AND BSL-1.0"
provides="valkey-modules-abi=$_modules_abi"
# Ships /etc/logrotate.d/valkey for the default file logs (RPM: Requires logrotate).
depends="logrotate"
makedepends="linux-headers openssl-dev pkgconf@@EXTRA_MAKEDEPENDS@@"
install="$pkgname.pre-install $pkgname.post-install"
pkgusers="valkey"
pkggroups="valkey"
# compat-redis-dev runs before -dev so it claims redismodule.h first.
subpackages="
	$pkgname-compat-redis-dev:_compat_redis_dev:noarch
	$pkgname-dev
	$pkgname-compat-redis:_compat_redis:noarch
	$pkgname-openrc
	"
source="valkey-$_srcver.tar.gz
	valkey-conf.patch
	valkey.initd
	valkey.confd
	valkey-sentinel.initd
	valkey-sentinel.confd
	valkey.logrotate
	valkey.sysctl
	"
if [ "$_with_docs" = 1 ]; then
	makedepends="$makedepends pandoc-cli python3 py3-yaml"
	subpackages="$subpackages $pkgname-doc"
	source="$source valkey-doc-$_docver.tar.gz"
fi
# Upstream tests need tcl and take a long time; the RPM spec does not run
# them by default either (%bcond_with tests).
options="!check"
builddir="$srcdir/valkey-$_srcver"

# Same flags as the RPM build, adapted to musl: bundled jemalloc instead of
# the system one, and no systemd notify support.
_build_flags="DEBUG= V=1 BUILD_TLS=yes MALLOC=jemalloc@@EXTRA_BUILD_FLAGS@@"

prepare() {
	default_prepare

	# The shared config patch targets systemd (Type=notify); OpenRC runs the
	# server in the foreground under supervise-daemon without notify.
	sed -i 's/^supervised systemd$/supervised no/' valkey.conf sentinel.conf
	grep -q '^supervised no$' valkey.conf && grep -q '^supervised no$' sentinel.conf \
		|| die "valkey-conf.patch no longer sets 'supervised systemd'; update prepare()"

	mv deps/lua/COPYRIGHT COPYRIGHT-lua
	mv deps/@@BUNDLED_DEP_DIR@@/COPYING COPYING-@@BUNDLED_DEP_NAME@@-BSD-3-Clause
	mv deps/hdr_histogram/LICENSE.txt LICENSE-hdrhistogram
	mv deps/hdr_histogram/COPYING.txt COPYING-hdrhistogram
	mv deps/fpconv/LICENSE.txt LICENSE-fpconv
	if [ -f deps/lz4/LICENSE ]; then
		mv deps/lz4/LICENSE LICENSE-lz4
	fi

	# jemalloc page size, as in the RPM spec (aarch64 kernels may use 64K pages).
	case "$CARCH" in
	aarch64) sed -i 's/--with-lg-quantum/--with-lg-page=16 --with-lg-quantum/' deps/Makefile ;;
	*) sed -i 's/--with-lg-quantum/--with-lg-page=12 --with-lg-quantum/' deps/Makefile ;;
	esac

	local api
	api=$(sed -n 's/#define VALKEYMODULE_APIVER_[0-9][0-9]* //p' src/valkeymodule.h)
	if [ "$api" != "$_modules_abi" ]; then
		die "upstream module API version is now $api, expected $_modules_abi; update _modules_abi"
	fi
}

build() {
	# abuild defaults to -Os; build at -O2 like the RPM (%optflags).
	export CFLAGS="$(printf '%s' "$CFLAGS" | sed 's/-Os/-O2/')"
	make $_build_flags

	# A Makefile that does not know BUILD_ZSTD ignores it silently
	# (e.g. the 9.2.0-rc1 tag), so check that the feature was compiled in.
	case "$_build_flags" in
	*BUILD_ZSTD=yes*)
		grep -q -- '-DHAVE_ZSTD' src/.make-settings \
			|| die "BUILD_ZSTD=yes was requested but zstd support was not compiled in"
		;;
	esac

	if [ "$_with_docs" = 1 ]; then
		make -C "$srcdir/valkey-doc-$_docver" VALKEY_ROOT="$builddir"
		make -C "$srcdir/valkey-doc-$_docver" html VALKEY_ROOT="$builddir"
	fi
}

package() {
	make install $_build_flags PREFIX="$pkgdir"/usr
	rm -rf "$pkgdir"/usr/share/valkey

	install -dm0750 -o valkey -g valkey \
		"$pkgdir"/var/lib/valkey \
		"$pkgdir"/var/lib/valkey/default \
		"$pkgdir"/var/log/valkey \
		"$pkgdir"/var/log/valkey/default
	# Sentinel (and CONFIG REWRITE) save by writing a temp file next to the
	# config and renaming it, so the valkey group needs write access here.
	# Same as the DEB package (2770); the RPM's root-owned 0755 makes
	# Sentinel fail with "Could not create tmp config file".
	install -dm0755 "$pkgdir"/etc/valkey/includes "$pkgdir"/usr/lib/valkey/modules
	chgrp valkey "$pkgdir"/etc/valkey
	chmod 2770 "$pkgdir"/etc/valkey

	install -Dm0640 -g valkey valkey.conf "$pkgdir"/etc/valkey/includes/valkey.defaults.conf
	install -Dm0640 -g valkey sentinel.conf "$pkgdir"/etc/valkey/includes/sentinel.defaults.conf
	install -Dm0640 -g valkey valkey.default.conf "$pkgdir"/etc/valkey/default.conf
	install -Dm0660 -g valkey sentinel.default.conf "$pkgdir"/etc/valkey/sentinel-default.conf

	install -Dm0644 "$srcdir"/valkey.sysctl "$pkgdir"/etc/sysctl.d/00-valkey.conf
	install -Dm0644 "$srcdir"/valkey.logrotate "$pkgdir"/etc/logrotate.d/valkey

	install -Dm0755 "$srcdir"/valkey.initd "$pkgdir"/etc/init.d/valkey
	install -Dm0644 "$srcdir"/valkey.confd "$pkgdir"/etc/conf.d/valkey
	install -Dm0755 "$srcdir"/valkey-sentinel.initd "$pkgdir"/etc/init.d/valkey-sentinel
	install -Dm0644 "$srcdir"/valkey-sentinel.confd "$pkgdir"/etc/conf.d/valkey-sentinel

	install -Dm0644 src/valkeymodule.h "$pkgdir"/usr/include/valkeymodule.h
	install -Dm0644 src/redismodule.h "$pkgdir"/usr/include/redismodule.h

	local f
	for f in COPYING COPYRIGHT-lua COPYING-@@BUNDLED_DEP_NAME@@-BSD-3-Clause \
		LICENSE-hdrhistogram COPYING-hdrhistogram LICENSE-fpconv LICENSE-lz4; do
		if [ -f "$f" ]; then
			install -Dm0644 "$f" "$pkgdir"/usr/share/licenses/$pkgname/"$f"
		fi
	done
	install -Dm0644 00-RELEASENOTES README.md -t "$pkgdir"/usr/share/doc/$pkgname/

	# redis-* names belong to valkey-compat-redis; 9.0+ installs some itself.
	local bin
	for bin in "$pkgdir"/usr/bin/valkey-*; do
		bin="${bin##*/}"
		[ -e "$pkgdir"/usr/bin/redis-"${bin#valkey-}" ] \
			|| ln -s "$bin" "$pkgdir"/usr/bin/redis-"${bin#valkey-}"
	done

	if [ "$_with_docs" = 1 ]; then
		make -C "$srcdir/valkey-doc-$_docver" install \
			INSTALL_MAN_DIR="$pkgdir"/usr/share/man VALKEY_ROOT="$builddir"
		mkdir -p "$pkgdir"/usr/share/doc/$pkgname/html
		cp -r "$srcdir/valkey-doc-$_docver"/_build/html/. "$pkgdir"/usr/share/doc/$pkgname/html/
		install -Dm0644 "$srcdir/valkey-doc-$_docver"/LICENSE \
			"$pkgdir"/usr/share/licenses/$pkgname-doc/LICENSE
	fi
}

doc() {
	default_doc
	# valkey-doc content is CC-BY-SA-4.0 (RPM: valkey-doc License).
	license="CC-BY-SA-4.0"
}

_compat_redis() {
	pkgdesc="Compatibility symlinks for Redis (redis-* commands)"
	depends="$pkgname=$pkgver-r$pkgrel !redis"
	amove 'usr/bin/redis-*'
}

_compat_redis_dev() {
	pkgdesc="Compatibility development header for Redis API Valkey modules"
	depends="$pkgname-dev=$pkgver-r$pkgrel !redis-dev"
	amove usr/include/redismodule.h
}
